DATABASE_URL=postgresql://user:pass@host:port/dbname
GITHUB_TOKEN=ghp_your_fine_grained_token
JWT_SECRET=change-this-to-random-string
CORS_ORIGIN=http://localhost:5174
PORT=3001
RESEND_API_KEY=re_your_resend_api_key
CONTACT_EMAIL=io@ezeke.dev
FROM_EMAIL=noreply@ezeke.dev

# Cloudflare Turnstile (bot protection for the contact form)
# Secret key from the Turnstile widget (server-side only — never commit the real value).
TURNSTILE_SECRET=your_turnstile_secret_key
# Comma-separated frontend hostnames the widget loads on.
# Production MUST NOT include localhost/127.0.0.1.
TURNSTILE_HOSTNAMES=localhost,127.0.0.1,ezequiell.com,www.ezequiell.com
